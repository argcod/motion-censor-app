# Smart Motion Detection Alarm System using IoT — local secrets (copy to .env and fill in; never commit real tokens)

# MySQL (read at startup — defaults are localhost / motion_db / root / root)
DB_HOST=localhost
DB_NAME=motion_db
DB_USER=root
DB_PASSWORD=root

# Serial
COM_PORT=COM3
BAUD_RATE=115200

# Camera
CAMERA_INDEX=0

# Telegram Bot API
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Discord webhook
ALERT_DISCORD_WEBHOOK=

# Twilio WhatsApp (official API only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+10000000000
